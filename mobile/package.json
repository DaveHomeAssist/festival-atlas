{
  "name": "festival-atlas-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "seed": "node scripts/generate-seed.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node scripts/smoke-test.cjs",
    "build:preview": "npx eas-cli build --profile preview",
    "build:production": "npx eas-cli build --profile production",
    "submit": "npx eas-cli submit --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~51.0.0",
    "expo-calendar": "~13.0.5",
    "expo-constants": "~16.0.0",
    "expo-device": "~6.0.2",
    "expo-file-system": "~17.0.1",
    "expo-image-picker": "~15.1.0",
    "expo-linking": "~6.3.0",
    "expo-location": "~17.0.1",
    "expo-notifications": "~0.28.19",
    "expo-router": "~3.5.0",
    "expo-sharing": "~12.0.1",
    "expo-status-bar": "~1.12.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-maps": "1.14.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1"
  },
  "devDependencies": {
    "@types/react": "~18.2.45",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~7.1.2",
    "typescript": "~5.3.3"
  },
  "overrides": {
    "tar": "^7.5.22",
    "postcss": "^8.5.26",
    "@expo/plist": {
      "@xmldom/xmldom": "^0.8.13"
    }
  }
