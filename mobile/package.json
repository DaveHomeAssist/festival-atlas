{
  "name": "festival-atlas-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "seed": "node scripts/generate-seed.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node scripts/smoke-test.cjs",
    "build:preview": "npx eas-cli build --profile preview",
    "build:production": "npx eas-cli build --profile production",
    "submit": "npx eas-cli submit --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-calendar": "~58.0.8",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "tar": "^7.5.22",
    "postcss": "^8.5.26",
    "@expo/fingerprint": {
      "minimatch": "^11.0.1"
    }
  }
